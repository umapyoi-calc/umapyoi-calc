{
  "name": "umapyoi-calc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "upload:storage": "node scripts/upload-storage.mjs",
    "check:storage": "node scripts/upload-storage.mjs --dry-run",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "check:seed": "node scripts/seed-firestore.mjs --dry-run",
    "check:data": "npm run check:storage && npm run check:seed",
    "sync:data": "npm run upload:storage && npm run seed:firestore",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project umapyoi-calc-dev",
    "publish:auto": "npm run sync:data && npm run deploy:hosting"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
